<?xml version="1.0" encoding="UTF-8"?>
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1">
      <part-name>Render Test A</part-name>
    </score-part>
  </part-list>
  <part id="P1">

    <!-- ============================================================= -->
    <!-- Measure 1 : EIGHT ordinary 32nd notes (test report 7.1)       -->
    <!-- EXPECTED after import: normal-size 32nd notes, BEAMS, in time -->
    <!-- (NOT small grace notes). Chord: Cmaj7                         -->
    <!-- ============================================================= -->
    <measure number="1">
      <attributes>
        <divisions>120</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <harmony>
        <root><root-step>C</root-step></root>
        <kind>major-seventh</kind>
      </harmony>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>15</duration><type>32nd</type></note>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>240</duration><type>half</type></note>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>120</duration><type>quarter</type></note>
    </measure>

    <!-- ============================================================= -->
    <!-- Measure 2 : one NATIVE MusicXML &lt;grace&gt; (test report #20) -->
    <!-- EXPECTED: the grace note is DROPPED on import (not shown,     -->
    <!-- not played); only the main notes remain. Chord: Fmaj7         -->
    <!-- ============================================================= -->
    <measure number="2">
      <harmony>
        <root><root-step>F</root-step></root>
        <kind>major-seventh</kind>
      </harmony>
      <note>
        <grace slash="1"/>
        <pitch><step>B</step><octave>3</octave></pitch>
        <type>eighth</type>
      </note>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>120</duration><type>quarter</type></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>240</duration><type>half</type></note>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>120</duration><type>quarter</type></note>
    </measure>

    <!-- ============================================================= -->
    <!-- Measure 3 : CONTROL - ordinary 16th / eighth notes           -->
    <!-- EXPECTED: always normal. Chord: G7                            -->
    <!-- ============================================================= -->
    <measure number="3">
      <harmony>
        <root><root-step>G</root-step></root>
        <kind>dominant</kind>
      </harmony>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>30</duration><type>16th</type></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>30</duration><type>16th</type></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>30</duration><type>16th</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>30</duration><type>16th</type></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>60</duration><type>eighth</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>60</duration><type>eighth</type></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>240</duration><type>half</type></note>
    </measure>

    <!-- ============================================================= -->
    <!-- Measure 4 : whole note ending (keeps the tail a main note,    -->
    <!-- avoids end-of-stream edge noise). Chord: Cmaj7                -->
    <!-- ============================================================= -->
    <measure number="4">
      <harmony>
        <root><root-step>C</root-step></root>
        <kind>major-seventh</kind>
      </harmony>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>480</duration><type>whole</type></note>
    </measure>

  </part>
</score-partwise>
